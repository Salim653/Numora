# Runtime
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public/publishable key from `pnpm supabase:status`; API uses it only to validate bearer sessions.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
# Reserved for future privileged server operations; onboarding does not use this key.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Database (Supabase local default)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Cloudflare R2 (not required for the Sprint-2 walking skeleton)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Observability (P1; optional during bootstrap)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
