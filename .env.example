# Runtime
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
# Cloud Development project. Copy the URL and publishable key from Supabase Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Private Cloud PostgreSQL connection. Use session pooler for long-lived API processes.
DATABASE_URL=
# Direct connection for the Database team's controlled migration only; not needed by normal dev.
DATABASE_MIGRATION_URL=
DB_POOL_MAX=3

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Cloudflare R2 (not required for the Sprint-2 walking skeleton)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Observability (P1; optional during bootstrap)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
