{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        },
        "summary": "Check API process health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/database": {
      "get": {
        "operationId": "HealthController_getDatabaseHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Database is reachable"
          }
        },
        "summary": "Check PostgreSQL connectivity",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/identity/me": {
      "get": {
        "operationId": "IdentityController_getProfile",
        "parameters": [
          {
            "name": "authorization",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProfileDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          },
          "404": {
            "description": "Google account has no internal profile yet."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "identity"
        ]
      },
      "post": {
        "operationId": "IdentityController_registerProfile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterProfileDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProfileDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          },
          "409": {
            "description": "Profile already exists or email is already in use."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "identity"
        ]
      }
    }
  },
  "info": {
    "title": "TKA Mathematics SMP API",
    "description": "REST contract for the TKA Mathematics SMP platform.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "IdentityProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER",
              "ADMIN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "teacherVerified": {
            "type": "boolean",
            "nullable": true
          },
          "studentAffiliation": {
            "type": "string",
            "enum": [
              "MANDIRI",
              "SCHOOL"
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "role",
          "status",
          "displayName",
          "email",
          "teacherVerified",
          "studentAffiliation"
        ]
      },
      "RegisterProfileDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER"
            ]
          }
        },
        "required": [
          "role"
        ]
      }
    }
  }
}
