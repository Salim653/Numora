  "info": {
    "title": "TKA Mathematics SMP API",
    "description": "REST contract for the TKA Mathematics SMP platform.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "IdentityProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER",
              "ADMIN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "teacherVerified": {
            "type": "boolean",
            "nullable": true
          },
          "studentAffiliation": {
            "type": "string",
            "enum": [
              "MANDIRI",
              "SCHOOL"
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "role",
          "status",
          "displayName",
          "email",
          "teacherVerified",
          "studentAffiliation"
        ]
      },
      "RegisterProfileDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "ClassSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ClassesResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClassSummaryDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "StudentSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "ClassStudentsResponseDto": {
        "type": "object",
        "properties": {
          "class": {
            "$ref": "#/components/schemas/ClassSummaryDto"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudentSummaryDto"
            }
          }
        },
        "required": [
          "class",
          "items"
        ]
      },
      "ChapterDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "title",
          "order"
        ]
      },
      "CatalogDto": {
        "type": "object",
        "properties": {
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChapterDto"
            }
          }
        },
        "required": [
          "chapters"
        ]
      },
      "SubchapterDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "chapterId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "chapterId",
          "title",
          "order"
        ]
      },
      "ChapterDetailDto": {
        "type": "object",
        "properties": {
          "chapter": {
            "$ref": "#/components/schemas/ChapterDto"
          },
          "subchapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubchapterDto"
            }
          }
        },
        "required": [
          "chapter",
          "subchapters"
        ]
      },
      "LevelDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "locked",
              "open",
              "inProgress",
              "completed"
            ]
          },
          "latestScore": {
            "type": "number",
            "nullable": true
          },
          "bestScore": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
          "order",
          "status",
          "latestScore",
          "bestScore"
        ]
      },
      "SubchapterDetailDto": {
        "type": "object",
        "properties": {
          "subchapter": {
            "$ref": "#/components/schemas/SubchapterDto"
          },
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LevelDto"
            }
          }
        },
        "required": [
          "subchapter",
          "levels"
        ]
      },
      "StudentProgressDto": {
        "type": "object",
        "properties": {
          "completedLevels": {
            "type": "number"
          },
          "totalLevels": {
            "type": "number"
          },
          "latestScore": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "completedLevels",
          "totalLevels",
          "latestScore"
        ]
      },
      "StartDrillDto": {
        "type": "object",
        "properties": {
          "levelId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "levelId"
        ]
      },
      "OptionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ]
      },
      "DrillQuestionDto": {
        "type": "object",
        "properties": {
          "questionInstanceId": {
            "type": "string",
            "format": "uuid"
          },
          "stem": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionDto"
            }
          },
          "selectedOptionId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "questionInstanceId",
          "stem",
          "options",
          "selectedOptionId"
        ]
      },
      "DrillAttemptDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "levelId": {
            "type": "string",
            "format": "uuid"
          },
          "levelTitle": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "inProgress",
              "completed"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isDemo": {
            "type": "boolean"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DrillQuestionDto"
            }
          }
        },
        "required": [
          "id",
          "levelId",
          "levelTitle",
          "status",
          "startedAt",
          "isDemo",
          "questions"
        ]
      },
      "SaveDrillAnswerDto": {
        "type": "object",
        "properties": {
          "optionId": {
            "type": "string",
            "nullable": true,
            "description": "A-D for demo; null clears the answer."
          }
        },
        "required": [
          "optionId"
        ]
      },
      "SavedAnswerDto": {
        "type": "object",
        "properties": {
          "questionInstanceId": {
            "type": "string",
            "format": "uuid"
          },
          "selectedOptionId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "questionInstanceId",
          "selectedOptionId"
        ]
      },
      "ReviewedQuestionDto": {
        "type": "object",
        "properties": {
          "questionInstanceId": {
            "type": "string",
            "format": "uuid"
          },
          "stem": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionDto"
            }
          },
          "selectedOptionId": {
            "type": "string",
            "nullable": true
          },
          "correctOptionId": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "questionInstanceId",
          "stem",
          "options",
          "selectedOptionId",
          "correctOptionId",
          "explanation"
        ]
      },
      "DrillResultDto": {
        "type": "object",
        "properties": {
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "levelId": {
            "type": "string",
            "format": "uuid"
          },
          "levelTitle": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "rawPoints": {
            "type": "number"
          },
          "correctCount": {
            "type": "number"
          },
          "questionCount": {
            "type": "number"
          },
          "mastered": {
            "type": "boolean"
          },
          "stars": {
            "type": "number",
            "nullable": true
          },
          "unlockedLevelId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "isDemo": {
            "type": "boolean"
          },
          "explanationState": {
            "type": "string",
            "enum": [
              "available",
              "expired"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewedQuestionDto"
            }
          }
        },
        "required": [
          "attemptId",
          "levelId",
          "levelTitle",
          "score",
          "rawPoints",
          "correctCount",
          "questionCount",
          "mastered",
          "stars",
          "unlockedLevelId",
          "isDemo",
          "explanationState",
          "questions"
        ]
      },
      "ClassDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "StudentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "MonitoredLevelDto": {
        "type": "object",
        "properties": {
          "levelId": {
            "type": "string",
            "format": "uuid"
          },
          "chapterLabel": {
            "type": "string"
          },
          "subchapterLabel": {
            "type": "string"
          },
          "levelLabel": {
            "type": "string"
          },
          "accessStatus": {
            "type": "string",
            "enum": [
              "LOCKED",
              "UNLOCKED"
            ]
