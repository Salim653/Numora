{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tka.local/contracts/questions/question.schema.json",
  "title": "TKA Question Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "externalId",
    "type",
    "chapterCode",
    "subchapterCode",
    "competencyCode",
    "difficulty",
    "stem",
    "answer",
    "explanation",
    "metadata"
  ],
  "properties": {
    "externalId": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["SINGLE_CHOICE", "MULTIPLE_CHOICE_MULTIPLE_ANSWER", "CATEGORY"]
    },
    "chapterCode": { "type": "string", "minLength": 1 },
    "subchapterCode": { "type": "string", "minLength": 1 },
    "competencyCode": { "type": "string", "minLength": 1 },
    "levelCode": { "type": ["string", "null"] },
    "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
    "stem": { "$ref": "#/$defs/richText" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "content": { "$ref": "#/$defs/richText" }
        }
      }
    },
    "answer": { "type": "object" },
    "explanation": { "$ref": "#/$defs/richText" },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "type": ["string", "null"] },
        "generationModel": { "type": ["string", "null"] },
        "generationBatchId": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "richText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "assetKeys": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}
